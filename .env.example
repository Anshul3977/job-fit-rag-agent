# Copy to .env. Never commit .env.

# Optional. When empty, the app uses the deterministic scorer (no network LLM).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Default is the current Groq free/developer replacement for Llama 3.1 8B Instant.
# Override if your account still has another model enabled.
GROQ_MODEL=openai/gpt-oss-20b

# auto | groq | deterministic
# auto uses Groq when GROQ_API_KEY is set, otherwise the deterministic scorer.
LLM_PROVIDER=auto

# SQLite by default. For Postgres + pgvector:
# DATABASE_URL=postgresql+psycopg://jobfit:jobfit@localhost:54329/jobfit
DATABASE_URL=sqlite:///./data/jobfit.db

# auto | chroma | pgvector | memory
# auto picks pgvector when DATABASE_URL is Postgres, otherwise Chroma.
VECTOR_BACKEND=auto
CHROMA_DIR=./data/chroma

# fastembed (local ONNX all-MiniLM-L6-v2) or hash (tests only, not semantic).
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./data/models

# dev enables /debug/retrieve when DEBUG_ROUTES=true. Use prod on a public host.
ENV=dev
DEBUG_ROUTES=true
LOG_LEVEL=INFO
PORT=8741

MAX_UPLOAD_BYTES=5000000
RATE_LIMIT_FIT_PER_MINUTE=10

# Comma-separated browser origins. The Docker app serves the UI itself, so this
# matters when the Vite dev server or a Vercel frontend calls the API.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

FRONTEND_DIST=frontend/dist
